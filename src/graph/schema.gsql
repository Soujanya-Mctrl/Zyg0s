// ==============================================================================
// TigerGraph Schema for HHGOA Fraud Investigation (IEEE-CIS Benchmark)
// ==============================================================================

CREATE VERTEX Customer (
    PRIMARY_ID id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Card (
    PRIMARY_ID id STRING,
    customer_id STRING,
    card_network STRING,
    card_type STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Transaction (
    PRIMARY_ID id STRING,
    ts DATETIME,
    amount DOUBLE,
    product_cd STRING,
    risk_score DOUBLE,
    channel STRING,
    dist1 DOUBLE,
    dist2 DOUBLE,
    addr1 STRING,
    addr2 STRING,
    p_emaildomain STRING,
    r_emaildomain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX DeviceProfile (
    PRIMARY_ID id STRING,
    device_info STRING,
    device_type STRING,
    os STRING,
    browser STRING,
    screen STRING,
    is_new BOOL
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX EmailDomain (
    PRIMARY_ID id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX BillingRegion (
    PRIMARY_ID id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX ClosedCase (
    PRIMARY_ID id STRING,
    customer_id STRING,
    card_id STRING,
    opened_at DATETIME,
    closed_at DATETIME,
    outcome STRING,
    pattern STRING,
    exposure_usd DOUBLE,
    analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Investigation_Case (
    PRIMARY_ID id STRING,
    verdict STRING,
    status STRING,
    pattern STRING,
    fraud_probability DOUBLE,
    exposure_usd DOUBLE,
    summary STRING,
    written_at DATETIME
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// ------------------------------------------------------------------------------
// Edges
// ------------------------------------------------------------------------------
CREATE UNDIRECTED EDGE OWNS (FROM Customer, TO Card);
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="REVERSE_MADE";
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="REVERSE_FROM_DEVICE";
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="REVERSE_PURCHASER_EMAIL";
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REVERSE_BILLED_IN";
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction) WITH REVERSE_EDGE="PREV";

CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="REVERSE_INVOLVES";
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="REVERSE_ON_CARD";
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="REVERSE_CONNECTED_TO";

CREATE DIRECTED EDGE CASE_INVOLVES_TXN (FROM Investigation_Case, TO Transaction) WITH REVERSE_EDGE="TXN_IN_CASE";
CREATE DIRECTED EDGE CASE_ON_CARD (FROM Investigation_Case, TO Card) WITH REVERSE_EDGE="CARD_IN_CASE";
CREATE DIRECTED EDGE CASE_CONNECTED_CARD (FROM Investigation_Case, TO Card) WITH REVERSE_EDGE="CARD_CONNECTED_CASE";
CREATE DIRECTED EDGE CASE_CONNECTED_DEVICE (FROM Investigation_Case, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_IN_CASE";

// ------------------------------------------------------------------------------
// Graph Definition
// ------------------------------------------------------------------------------
CREATE GRAPH HHGOA_Fraud (
    Customer,
    Card,
    Transaction,
    DeviceProfile,
    EmailDomain,
    BillingRegion,
    ClosedCase,
    Investigation_Case,
    OWNS,
    MADE,
    FROM_DEVICE,
    PURCHASER_EMAIL,
    BILLED_IN,
    NEXT,
    INVOLVES,
    ON_CARD,
    CONNECTED_TO,
    CASE_INVOLVES_TXN,
    CASE_ON_CARD,
    CASE_CONNECTED_CARD,
    CASE_CONNECTED_DEVICE
)
