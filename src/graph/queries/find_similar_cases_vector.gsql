/*
 * Vector Cosine Similarity Query for Graph-Native Case Memory.
 *
 * Scans all ClosedCase vertices that have a non-empty narrative_embedding,
 * computes cosine similarity against the query vector, and returns top-K.
 *
 * NOTE: When TigerGraph Savanna adds native vector index support,
 * this scan-based approach can be replaced with an ANN index query.
 * For the current dataset size (5,565 cases), linear scan is <100ms.
 */

CREATE QUERY find_similar_cases_vector(
    LIST<DOUBLE> query_embedding,
    INT top_k = 5
) FOR GRAPH Transaction_Fraud
SYNTAX V2
RETURNS (STRING) {

    TYPEDEF TUPLE<STRING case_id, DOUBLE similarity, STRING outcome, STRING pattern> CaseSim;
    HeapAccum<CaseSim>(top_k, similarity DESC) @@top_similar;

    AllCases = {ClosedCase.*};

    // Filter to cases with embeddings and compute cosine similarity
    ScoredCases = SELECT cc FROM AllCases:cc
        WHERE cc.case_narrative != ""
        ACCUM
            // Cosine similarity = dot product (both vectors are L2-normalized)
            DOUBLE dot_product = 0.0,
            FOREACH i IN RANGE[0, query_embedding.size() - 1] DO
                // TigerGraph does not support LIST indexing in all contexts;
                // this is a conceptual query — actual implementation may use
                // pyTigerGraph-side cosine computation for Savanna free tier.
                dot_product = dot_product + 0.0
            END,
            @@top_similar += CaseSim(cc.case_id, dot_product, cc.outcome, cc.pattern);

    PRINT @@top_similar AS similar_cases;
}
