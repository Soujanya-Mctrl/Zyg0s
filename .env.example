# TigerGraph Savanna Cloud Configuration
TG_HOST=your-workspace-host.i.tgcloud.io
TG_PORT=14240
TG_GRAPHNAME=Transaction_Fraud
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_SECRET=your_tigergraph_secret_or_token

# LLM Reasoning & Embeddings Configuration
OPENAI_API_KEY=your_openai_api_key
# Optional Anthropic / Google Gemini API keys
ANTHROPIC_API_KEY=your_anthropic_api_key
